{
  "name": "air-gb-wallet",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run native:build && concurrently -k \"npm run dev -w @airgb/service\" \"npm run dev -w @airgb/web\"",
    "dev:regtest": "npm run native:build && concurrently -k \"npm run dev:regtest -w @airgb/service\" \"npm run dev -w @airgb/web\"",
    "dev:peer": "npm run native:build && node infra/regtest/run-peer.mjs",
    "build": "npm run build -w @airgb/web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test packages/policy/*.test.ts apps/local-service/*.test.ts",
    "native:build": "node infra/native/build.mjs"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "concurrently": "9.2.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.19.0"
  }
}
