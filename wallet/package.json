{
  "name": "air-gb-wallet",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run native:build && concurrently -k \"npm run dev -w @airgb/service\" \"npm run dev -w @airgb/web\"",
    "dev:regtest": "npm run native:build && concurrently -k \"npm run dev:regtest -w @airgb/service\" \"npm run dev -w @airgb/web\"",
    "dev:peer": "npm run native:build && node infra/regtest/run-peer.mjs",
    "dev:user": "npm run dev:user -w @airgb/service",
    "dev:ui": "npm run dev -w @airgb/web",
    "dev:demo": "npm run dev -w @airgb/web-demo",
    "build": "npm run build -w @airgb/web",
    "build:demo": "npm run build -w @airgb/web-demo",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test packages/policy/*.test.ts apps/local-service/*.test.ts tests/*.test.ts",
    "test:fixtures": "node --import tsx --test tests/routing-history.test.ts tests/topology.test.ts tests/fixture-scoring.test.ts tests/fixture-payments.test.ts",
    "test:rgb": "node infra/regtest/run-rgb.mjs",
    "test:mpp": "npm run native:build && node --env-file=native-data/regtest/wallet.env --import tsx infra/regtest/e2e-mpp.mjs",
    "cli": "node --env-file=native-data/regtest/wallet.env --import tsx infra/regtest/cli.mjs",
    "native:build": "node infra/native/build.mjs",
    "qvac:doctor": "qvac doctor",
    "qvac:precache": "node scripts/qvac-precache.mjs",
    "qvac:serve": "qvac serve --openai --port 11434 -c qvac.config.json",
    "qvac:smoke": "node --import tsx scripts/qvac-smoke-test.mjs",
    "qvac:smoke:scoring": "node --import tsx infra/regtest/smoke-qvac-scoring.mjs",
    "benchmark:run": "node infra/benchmark/run.mjs",
    "benchmark:compare": "node infra/benchmark/compare.mjs",
    "benchmark:unit": "node --test infra/benchmark/benchmark.test.mjs"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@utexo/wdk-wallet-rgb": "2.0.3",
    "concurrently": "9.2.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.19.0"
  }
}
