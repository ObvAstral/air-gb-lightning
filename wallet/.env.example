# QVAC must listen on loopback; this is a model alias configured in QVAC.
QVAC_URL=http://127.0.0.1:11434
QVAC_MODEL=my-llm
PORT=8787
AIRGB_DATA_DIR=../../native-data/wallet
BITCOIND_RPC_USER=user
BITCOIND_RPC_PASSWORD=
BITCOIND_RPC_HOST=127.0.0.1
BITCOIND_RPC_PORT=18443
INDEXER_URL=tcp://127.0.0.1:50001
RGB_PROXY_ENDPOINT=rpc://127.0.0.1:3000/json-rpc
# Keep disabled until the regtest receive/send/status flow is proven.
ENABLE_REGTEST_SEND=0
